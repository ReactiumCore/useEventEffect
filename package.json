{
  "name": "@atomic-reactor/use-event-effect",
  "version": "1.0.0",
  "description": "A React hook that subscribes components to @atomic-reactor/event-handle targets (or any EventTarget). Works in React DOM and React Native.",
  "author": "camdagr8",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ReactiumCore/useEventEffect"
  },
  "bugs": {
    "url": "https://github.com/ReactiumCore/useEventEffect/issues"
  },
  "homepage": "https://github.com/ReactiumCore/useEventEffect#readme",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "keywords": [
    "react",
    "react-hooks",
    "hook",
    "event",
    "events",
    "eventtarget",
    "event-emitter",
    "react-native"
  ],
  "dependencies": {
    "@atomic-reactor/event-handle": "^1.0.2"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  }
}
