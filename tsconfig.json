{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // No "DOM" lib on purpose: the library must only use language built-ins
    // so it runs unchanged in React DOM and React Native
    "lib": ["ES2019"],
    "types": [],
    "strict": true,
    "declaration": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src"]
}
